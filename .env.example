# Copia este archivo a .env; NO publiques .env ni el token de tu bot.

# Cada cuánto se revisa el servidor (segundos; mínimo 1).
SW_INTERVAL=30

# Alertar al alcanzar o superar estos porcentajes (0 a 100).
SW_CPU_THRESHOLD=90
SW_RAM_THRESHOLD=90
SW_DISK_THRESHOLD=90

# Ruta del sistema de archivos que se quiere vigilar.
SW_DISK_PATH=/

# Repetir alertas activas como máximo una vez cada N segundos.
SW_ALERT_COOLDOWN=1800

# Recuperación: el uso debe bajar al menos esta cantidad de puntos porcentuales.
SW_RECOVERY_MARGIN=5

# Cantidad de procesos mostrados, ordenados por consumo de RAM.
SW_TOP_PROCESSES=5

# Duración de la muestra de CPU; más tiempo = medida menos brusca.
SW_CPU_SAMPLE_SECONDS=0.3

# Opcional: activa notificaciones por Telegram llenando AMBOS campos.
# Crea tu bot en @BotFather y obtiene el chat_id de un chat autorizado.
SW_TELEGRAM_BOT_TOKEN=
SW_TELEGRAM_CHAT_ID=

# ServerWatch 2.0 (panel + historial)
SW_DATABASE=./serverwatch.sqlite3
SW_RETENTION_DAYS=30
SW_OFFLINE_AFTER=120
SW_DASHBOARD_HOST=127.0.0.1
SW_DASHBOARD_PORT=8787
# Obligatorio si el panel escucha fuera de localhost (mínimo 16 caracteres).
SW_DASHBOARD_PASSWORD=

# Al habilitar agentes remotos: token aleatorio compartido, mínimo recomendado 32 bytes.
# Genera uno: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SW_INGEST_TOKEN=
# Solo agente: https://tu-dominio-seguro.example (HTTP solo permitido en localhost).
SW_HUB_URL=
# Opcional: identificador del agente, diferente por servidor.
SW_NODE_NAME=
# Opcional: unidades systemd, separadas por comas (ej. ssh,nginx,postgresql).
SW_SERVICES=
